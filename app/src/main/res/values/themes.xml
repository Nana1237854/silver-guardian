<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SilverGuardian" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_orange</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_page</item>
        <item name="android:navigationBarColor">@color/surface_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorControlHighlight">@color/mint_soft</item>
        <item name="materialButtonStyle">@style/SilverGuardianButton</item>
    </style>
    <style name="SilverGuardianButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="BottomNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/bottom_nav_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.SilverGuardian" parent="TextAppearance.MaterialComponents.Body1" />
    <style name="TextAppearance.SilverGuardian.PageTitle">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.SilverGuardian.SectionTitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.SilverGuardian.GroupLabel">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.SilverGuardian.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.SilverGuardian.BodyMuted">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.SilverGuardian.DetailValue">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.SilverGuardian.EmptyState">
        <item name="android:textSize">@dimen/empty_state_text_size</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Widget.SilverGuardian" parent="@android:style/Widget.TextView" />
    <style name="Widget.SilverGuardian.SectionLabel">
        <item name="android:textAppearance">@style/TextAppearance.SilverGuardian.SectionTitle</item>
        <item name="android:paddingBottom">@dimen/section_label_spacing_bottom</item>
    </style>
    <style name="Widget.SilverGuardian.GroupLabel">
        <item name="android:textAppearance">@style/TextAppearance.SilverGuardian.GroupLabel</item>
        <item name="android:paddingStart">@dimen/group_label_inset_start</item>
        <item name="android:paddingTop">@dimen/group_label_spacing_top</item>
        <item name="android:paddingBottom">@dimen/group_label_spacing_bottom</item>
    </style>
    <style name="Widget.SilverGuardian.SecondaryTextAction">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">@dimen/secondary_action_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
    </style>
    <style name="Widget.SilverGuardian.PrimaryTextAction">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/surface_white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/button_padding_horizontal</item>
    </style>
    <style name="Widget.SilverGuardian.ChipText">
        <item name="android:background">@drawable/bg_chip_soft</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/chip_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/chip_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/chip_padding_vertical</item>
    </style>
    <style name="Widget.SilverGuardian.CompactChip">
        <item name="android:background">@drawable/bg_chip_soft</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">@dimen/compact_chip_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/compact_chip_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/compact_chip_padding_vertical</item>
        <item name="android:paddingEnd">@dimen/compact_chip_padding_horizontal</item>
        <item name="android:paddingBottom">@dimen/compact_chip_padding_vertical</item>
    </style>
    <style name="Widget.SilverGuardian.SurfaceCardBlock">
        <item name="android:background">@drawable/bg_group_surface</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>
    <style name="Widget.SilverGuardian.DetailBulletText">
        <item name="android:textAppearance">@style/TextAppearance.SilverGuardian.Body</item>
        <item name="android:lineSpacingExtra">@dimen/detail_body_line_spacing</item>
    </style>
    <style name="Widget.SilverGuardian.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="android:elevation">2dp</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="itemIconSize">@dimen/bottom_nav_icon_size</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
