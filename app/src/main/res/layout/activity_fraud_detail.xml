<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/page_top_padding_compact"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/page_bottom_padding_standalone">

        <include
            android:id="@+id/fraud_detail_header"
            layout="@layout/view_page_header" />

        <!-- 离线提示条 -->
        <include
            android:id="@+id/fraud_detail_offline_hint"
            layout="@layout/view_status_strip"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/fraud_detail_category"
            style="@style/Widget.SilverGuardian.CompactChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/fraud_detail_title"
            style="@style/TextAppearance.SilverGuardian.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fraud_detail_title_gap_top"
            android:layout_marginBottom="@dimen/fraud_detail_title_gap_bottom" />

        <!-- 骗局简介 / 案例详情 -->
        <include
            android:id="@+id/fraud_detail_summary_section"
            layout="@layout/view_card_section" />

        <include
            android:id="@+id/fraud_detail_case_section"
            layout="@layout/view_card_section" />

        <!-- 风险说明 -->
        <include
            android:id="@+id/fraud_detail_risk_section"
            layout="@layout/view_card_section" />

        <!-- 防范措施 / 对策建议 -->
        <include
            android:id="@+id/fraud_detail_advice_section"
            layout="@layout/view_card_section" />

        <!-- 内容来源 -->
        <include
            android:id="@+id/fraud_detail_source_section"
            layout="@layout/view_card_section" />
    </LinearLayout>
</ScrollView>
