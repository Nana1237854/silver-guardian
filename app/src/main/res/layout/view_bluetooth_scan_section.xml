<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Widget.SilverGuardian.SectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_label_spacing_top"
        android:paddingBottom="@dimen/section_label_spacing_bottom"
        android:text="@string/bluetooth_section_scan" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:background="@drawable/bg_group_surface"
        android:orientation="vertical"
        android:padding="@dimen/group_card_padding_compact">

        <TextView
            android:id="@+id/bluetooth_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bluetooth_scan_button"
            style="@style/Widget.SilverGuardian.PrimaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/bluetooth_mock_button"
            style="@style/Widget.SilverGuardian.SecondaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</LinearLayout>