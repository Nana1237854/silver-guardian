<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/page_top_padding_compact"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/bottom_nav_safe_space">

    <include
        android:id="@+id/fraud_header"
        layout="@layout/view_page_header" />

    <TextView
        android:id="@+id/fraud_refresh"
        style="@style/Widget.SilverGuardian.ChipText"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/fraud_refresh" />

    <include
        android:id="@+id/fraud_loading_hint"
        layout="@layout/view_status_strip"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fraud_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_bottom_padding" />
</LinearLayout>