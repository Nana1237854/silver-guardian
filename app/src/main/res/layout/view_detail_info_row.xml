<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="@dimen/detail_row_padding_top">

    <TextView
        android:id="@+id/detail_info_label"
        style="@style/TextAppearance.SilverGuardian.BodyMuted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/detail_info_value"
        style="@style/TextAppearance.SilverGuardian.DetailValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/detail_row_gap"
        android:layout_weight="1" />
</LinearLayout>