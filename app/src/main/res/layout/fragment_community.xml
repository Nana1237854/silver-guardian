<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/page_top_padding_compact"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="0dp">

    <include
        android:id="@+id/community_header"
        layout="@layout/view_page_header" />

    <include
        android:id="@+id/community_search_section"
        layout="@layout/view_community_search_section" />

    <include
        android:id="@+id/community_empty_state"
        layout="@layout/view_empty_state" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/community_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_safe_space" />
</LinearLayout>
