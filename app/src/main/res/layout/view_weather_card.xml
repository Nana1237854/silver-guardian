<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_card_surface" android:clickable="true" android:focusable="true"
    android:minHeight="128dp" android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="天气出行建议" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/home_weather_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="正在定位并获取天气…" android:textColor="@color/text_primary" android:textSize="15sp" />
    <TextView android:id="@+id/home_weather_advice" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:maxLines="4" android:ellipsize="end"
        android:text="将综合天气、温度和空气质量生成出行建议。" android:textColor="@color/text_secondary" android:textSize="14sp" />
</LinearLayout>