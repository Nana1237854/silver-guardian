<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_form_padding_horizontal_wide"
    android:paddingTop="@dimen/dialog_form_padding_top"
    android:paddingEnd="@dimen/dialog_form_padding_horizontal_wide"
    android:paddingBottom="0dp">

    <ImageView
        android:id="@+id/album_upload_preview"
        android:layout_width="@dimen/album_upload_preview_size"
        android:layout_height="@dimen/album_upload_preview_size"
        android:adjustViewBounds="true"
        android:background="@color/surface_mint"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_album" />

    <TextView
        android:id="@+id/album_upload_pick_chip"
        style="@style/Widget.SilverGuardian.ChipText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:text="@string/album_pick_from_gallery" />

    <LinearLayout
        android:id="@+id/album_upload_fields_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>