<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|top"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/chat_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="@string/chat_avatar_ai_desc"
        android:scaleType="centerCrop"
        android:src="@drawable/ai_companion" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chat_bubble"
            style="@style/TextAppearance.SilverGuardian.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_ai_bubble"
            android:lineSpacingExtra="@dimen/detail_body_line_spacing"
            android:maxWidth="286dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/chat_time"
            style="@style/TextAppearance.SilverGuardian.BodyMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp" />
    </LinearLayout>
</LinearLayout>
