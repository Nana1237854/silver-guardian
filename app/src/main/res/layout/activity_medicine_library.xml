<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_page" android:orientation="vertical" android:padding="@dimen/screen_padding"><include android:id="@+id/library_header" layout="@layout/view_page_header"/><EditText android:id="@+id/library_search" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_chat_input" android:hint="搜索药品名、疾病或品牌" android:paddingStart="16dp" android:paddingEnd="16dp"/><TextView android:id="@+id/library_add" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_primary" android:gravity="center" android:text="新增药品" android:textColor="@color/surface_white" android:textStyle="bold"/><TextView android:id="@+id/library_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="暂无匹配药品" android:textColor="@color/text_secondary"/><androidx.recyclerview.widget.RecyclerView android:id="@+id/library_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/></LinearLayout>