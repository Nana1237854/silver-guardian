<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/home_bottom_safe_space">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <include layout="@layout/view_home_welcome_hero" />

        <LinearLayout
            android:id="@+id/home_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="-12dp"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/bg_card_surface"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/home_summary_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_summary_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include android:id="@+id/home_metric_blood_pressure" layout="@layout/view_home_metric_item" />
                <View android:layout_width="1dp" android:layout_height="48dp" android:background="@color/divider" />
                <include android:id="@+id/home_metric_heart_rate" layout="@layout/view_home_metric_item" />
                <View android:layout_width="1dp" android:layout_height="48dp" android:background="@color/divider" />
                <include android:id="@+id/home_metric_blood_oxygen" layout="@layout/view_home_metric_item" />
                <View android:layout_width="1dp" android:layout_height="48dp" android:background="@color/divider" />
                <include android:id="@+id/home_metric_sleep" layout="@layout/view_home_metric_item" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/home_safe_check_card"
            layout="@layout/view_safe_check_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_padding" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_padding"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_call_action"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:textColor="@color/surface_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_sos_action"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_sos"
                android:gravity="center"
                android:textColor="@color/surface_white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_shortcuts_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include android:id="@+id/home_health_action" layout="@layout/view_home_shortcut_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <include android:id="@+id/home_medicine_action" layout="@layout/view_home_shortcut_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <include android:id="@+id/home_album_action" layout="@layout/view_home_shortcut_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <include android:id="@+id/home_settings_action" layout="@layout/view_home_shortcut_row" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_ai_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/screen_padding"
            android:background="@drawable/bg_ai_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="116dp"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/home_ai_image"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ai_companion" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/home_ai_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_dark"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_ai_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/home_ai_cta"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:textColor="@color/surface_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <include
            android:id="@+id/home_weather_card"
            layout="@layout/view_weather_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_padding" />

    </LinearLayout>
</ScrollView>