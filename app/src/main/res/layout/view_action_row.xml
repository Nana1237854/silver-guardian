<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/action_row_padding_top">

    <TextView
        android:id="@+id/action_left"
        style="@style/Widget.SilverGuardian.SecondaryTextAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/action_center"
        style="@style/Widget.SilverGuardian.SecondaryTextAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/action_row_gap"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/action_right"
        style="@style/Widget.SilverGuardian.PrimaryTextAction"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/action_row_gap"
        android:minWidth="@dimen/action_primary_min_width" />
</LinearLayout>