<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- Medicine grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/medicine_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="84dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

    <Spinner
        android:id="@+id/medicine_filter"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_surface" />

    <!-- FAB: Add medicine -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_medicine_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/add_medicine"
        app:backgroundTint="#16a34a"
        app:tint="@color/surface_white" />
</FrameLayout>
