<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/medicine_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingTop="260dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="246dp"
        android:background="@color/bg_page"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用药提醒"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/add_medicine_fab"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:contentDescription="@string/add_medicine"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="10dp"
            android:focusable="true"
            android:gravity="center"
            android:text="添加药品提醒"
            android:textColor="@color/surface_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/medicine_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="今日已打卡 0/0"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/medicine_filter"
                android:layout_width="150dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_card_surface"
                android:paddingStart="12dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_reminder_strip"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="按时服药，守护健康每一天\n08:00 · 12:00 · 16:00 · 20:00"
            android:textColor="@color/primary_dark"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
