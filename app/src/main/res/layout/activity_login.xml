<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="34dp"
        android:paddingEnd="24dp"
        android:paddingBottom="34dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="银发守护 AI 助手"
            android:scaleType="centerCrop"
            android:src="@drawable/ai_companion" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/login_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/login_subtitle"
            style="@style/TextAppearance.SilverGuardian.BodyMuted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/login_select_user"
            style="@style/TextAppearance.SilverGuardian.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/user_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/selected_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/add_user_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chat_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/login_add_user"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="2dp"
            app:contentPadding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pin_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/pin_input"
                    android:text="@string/login_enter_pin"
                    style="@style/TextAppearance.SilverGuardian.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pin_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <EditText android:id="@+id/pin_input" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:gravity="center" android:inputType="numberPassword" android:letterSpacing="0.35" android:maxLength="4" android:textColor="@color/text_primary" android:textSize="28sp" />
                    <ImageButton android:id="@+id/pin_visibility" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="显示或隐藏 PIN" android:padding="12dp" android:src="@drawable/ic_visibility" />
                </LinearLayout>
                <TextView android:id="@+id/forgot_pin" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end" android:gravity="center" android:text="忘记 PIN？" android:textColor="@color/primary_dark" android:textSize="@dimen/text_body" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:enabled="false"
            android:text="@string/login_confirm"
            android:textColor="@color/surface_white"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
