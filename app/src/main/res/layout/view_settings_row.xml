<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_start_padding"
    android:paddingTop="@dimen/settings_row_vertical_padding"
    android:paddingEnd="@dimen/settings_row_end_padding"
    android:paddingBottom="@dimen/settings_row_vertical_padding">

    <ImageView
        android:id="@+id/settings_row_icon"
        android:layout_width="@dimen/settings_row_icon_size"
        android:layout_height="@dimen/settings_row_icon_size"
        android:background="@drawable/bg_icon_mint"
        android:contentDescription="@null"
        android:padding="@dimen/settings_row_icon_padding" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/settings_row_text_gap"
        android:paddingEnd="@dimen/settings_row_text_padding_end">

        <TextView
            android:id="@+id/settings_row_title"
            style="@style/TextAppearance.SilverGuardian.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_row_subtitle"
            style="@style/TextAppearance.SilverGuardian.BodyMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_row_subtitle_gap" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settings_row_end_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>