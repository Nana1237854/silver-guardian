<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/home_bottom_safe_space">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/home_mode_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/home_safe_check_card"
            layout="@layout/view_safe_check_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/home_sos_action"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_sos"
            android:gravity="center"
            android:textColor="@color/surface_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_call_action"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:textColor="@color/surface_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_medicine_action"
            style="@style/Widget.SilverGuardian.SecondaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="20dp"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/home_ai_action"
            style="@style/Widget.SilverGuardian.SecondaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="20dp"
            android:textSize="24sp" />
    </LinearLayout>
</ScrollView>