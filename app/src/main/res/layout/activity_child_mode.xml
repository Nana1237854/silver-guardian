<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/page_top_padding_compact"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/page_bottom_padding_standalone">

        <include
            android:id="@+id/child_mode_header"
            layout="@layout/view_page_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_gap"
            android:background="@drawable/bg_group_surface"
            android:orientation="vertical"
            android:padding="@dimen/group_card_padding_compact">

            <TextView
                android:id="@+id/child_mode_intro_title"
                style="@style/TextAppearance.SilverGuardian.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/child_mode_intro_title" />

            <TextView
                android:id="@+id/child_mode_intro_body"
                style="@style/TextAppearance.SilverGuardian.BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/child_intro_gap_top"
                android:lineSpacingExtra="@dimen/status_strip_line_spacing"
                android:text="@string/child_mode_intro_body" />

            <ImageView
                android:id="@+id/child_mode_banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/child_intro_banner_height"
                android:layout_marginTop="@dimen/child_intro_banner_gap"
                android:background="@drawable/bg_card_surface"
                android:contentDescription="@string/child_mode_banner_desc"
                android:scaleType="centerCrop"
                android:src="@drawable/family_companion" />
        </LinearLayout>

        <include android:id="@+id/child_mode_health_block" layout="@layout/view_card_section" />
        <include android:id="@+id/child_mode_medicine_block" layout="@layout/view_card_section" />
        <include android:id="@+id/child_mode_alert_block" layout="@layout/view_card_section" />
        <include android:id="@+id/child_mode_family_block" layout="@layout/view_card_section" />

        <TextView
            android:id="@+id/child_mode_upload_button"
            style="@style/Widget.SilverGuardian.PrimaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/section_gap"
            android:layout_marginBottom="@dimen/child_action_gap_bottom"
            android:text="@string/child_mode_upload_for_elder" />

        <TextView
            android:id="@+id/child_mode_call_button"
            style="@style/Widget.SilverGuardian.SecondaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="12dp"
            android:text="一键回拨" />
        <TextView
            android:id="@+id/child_mode_add_medicine_button"
            style="@style/Widget.SilverGuardian.SecondaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="8dp"
            android:text="添加用药提醒" />
        <TextView
            android:id="@+id/child_mode_library_button"
            style="@style/Widget.SilverGuardian.SecondaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="8dp"
            android:text="&#x7BA1;&#x7406;&#x836F;&#x54C1;&#x5E93;" />
        <TextView
            android:id="@+id/child_mode_location_button"
            style="@style/Widget.SilverGuardian.SecondaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="8dp"
            android:text="查看老人位置" />

        <TextView
            android:id="@+id/child_mode_back_button"
            style="@style/Widget.SilverGuardian.SecondaryTextAction"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:text="@string/child_mode_back_to_elder" />
    </LinearLayout>
</ScrollView>