<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/child_detail_min_height"
    android:orientation="horizontal"
    android:paddingTop="@dimen/child_detail_vertical_padding"
    android:paddingBottom="@dimen/child_detail_vertical_padding">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/child_detail_title"
            style="@style/TextAppearance.SilverGuardian.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/child_detail_subtitle"
            style="@style/TextAppearance.SilverGuardian.BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/child_detail_subtitle_gap" />
    </LinearLayout>

    <TextView
        android:id="@+id/child_detail_chip"
        style="@style/Widget.SilverGuardian.CompactChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/child_detail_chip_gap" />
</LinearLayout>