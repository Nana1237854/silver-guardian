<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:background="@drawable/bg_group_surface"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="170dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp">

        <TextView
            android:id="@+id/all_photos_title"
            style="@style/TextAppearance.SilverGuardian.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_dark" />

        <TextView
            android:id="@+id/all_photos_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/all_photos_cover"
        android:layout_width="152dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:contentDescription="@string/album_cover_desc"
        android:scaleType="centerCrop" />
</FrameLayout>