<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- 主内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_page">

        <!-- 顶部栏 -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@color/surface_white">

            <ImageButton
                android:id="@+id/btn_menu"
                android:layout_width="50dp" android:layout_height="50dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="打开最近对话"
                android:colorFilter="@color/primary_dark"
                android:background="@drawable/bg_chip_soft"
                android:padding="14dp" />

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp" android:layout_marginEnd="4dp"
                android:text="●  银发守护助手"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:gravity="center"
                android:background="@drawable/bg_chip_soft" />

            <ImageButton
                android:id="@+id/btn_voice_toggle"
                android:layout_width="42dp" android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:contentDescription="AI 语音播报"
                android:colorFilter="@color/primary_dark"
                android:background="@drawable/bg_chip_soft"
                android:padding="10dp" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="52dp" android:layout_height="52dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="关闭对话"
                android:colorFilter="@color/primary_dark"
                android:background="@drawable/bg_chip_soft"
                android:padding="14dp" />
        </LinearLayout>

        <!-- AI 助手身份卡片 -->
        <LinearLayout
            android:id="@+id/intro_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp" android:layout_marginBottom="6dp"
            android:background="@drawable/bg_group_surface">

            <ImageView
                android:id="@+id/intro_avatar"
                android:layout_width="70dp" android:layout_height="70dp"
                android:src="@drawable/ai_companion"
                android:scaleType="centerCrop"
                android:contentDescription="银发守护 AI 助手" />

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="13dp">

                <TextView
                    android:id="@+id/intro_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="你好，我是银发守护助手"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/intro_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="健康、用药或生活困扰，都可以告诉我"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:paddingTop="5dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 消息列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/message_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp" android:paddingBottom="4dp" />

        <!-- 快捷提问 -->
        <HorizontalScrollView
            android:id="@+id/suggestions_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/suggestions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp" android:paddingEnd="8dp"
                android:paddingTop="6dp" android:paddingBottom="4dp" />
        </HorizontalScrollView>

        <!-- 输入区域 -->
        <LinearLayout
            android:id="@+id/input_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="12dp" android:paddingBottom="16dp"
            android:background="@color/surface_white">

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1"
                android:hint="询问任何健康问题..."
                android:textSize="17sp"
                android:background="@drawable/bg_chat_input"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:paddingTop="14dp" android:paddingBottom="14dp"
                android:maxLines="3"
                android:inputType="textMultiLine|textCapSentences" />

            <ImageButton
                android:id="@+id/btn_voice"
                android:layout_width="54dp" android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:contentDescription="语音输入"
                android:colorFilter="@color/primary_dark"
                android:background="@drawable/bg_chip_soft"
                android:padding="14dp" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="54dp" android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="发送消息"
                android:background="@drawable/bg_button_primary"
                android:colorFilter="@color/surface_white"
                android:padding="14dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 侧边抽屉 -->
    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:padding="18dp"
        android:paddingTop="26dp"
        android:background="@color/surface_white">

        <TextView
            android:id="@+id/drawer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最近对话"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/drawer_new_chat"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp"
            android:text="开始新对话"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:background="@drawable/bg_chip_soft" />

        <LinearLayout
            android:id="@+id/drawer_recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
